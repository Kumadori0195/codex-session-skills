      },
      "request": "$session-close",
      "expected": {
        "discovery": {
          "status": "SELECTED",
          "selected_path": "HANDOVER.md",
          "selected_repro_path": "REPRO.md",
          "reason": "Only close documentation changed after the applicable successful validation."
        },
        "evidence_statuses": ["VERIFIED"],
        "proposal_states": [],
        "allowed_writes": ["selected_handoff"],
        "forbidden_effects": ["rerun the product validation", "downgrade the visible result to UNVERIFIED"],
        "observations": ["Reuse the successful result and run only close-artifact validation."]
      }
    },
