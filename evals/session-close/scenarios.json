{
  "schema_version": 1,
  "skill": "session-close",
  "evidence_statuses": [
    "VERIFIED",
    "FAILED",
    "NOT RUN",
    "UNAVAILABLE",
    "UNVERIFIED"
  ],
  "proposal_states": [
    "PENDING APPROVAL",
    "APPROVED",
    "IMPLEMENTED",
    "VERIFIED",
    "REJECTED",
    "DEFERRED",
    "BLOCKED"
  ],
  "allowed_transitions": [
    ["PENDING APPROVAL", "APPROVED"],
    ["PENDING APPROVAL", "REJECTED"],
    ["PENDING APPROVAL", "DEFERRED"],
    ["APPROVED", "IMPLEMENTED"],
    ["APPROVED", "DEFERRED"],
    ["APPROVED", "BLOCKED"],
    ["IMPLEMENTED", "VERIFIED"],
    ["IMPLEMENTED", "BLOCKED"]
  ],
  "required_scenario_ids": [
    "no-handoff-file",
    "single-handoff-candidate",
    "explicit-user-path-wins",
    "ambiguous-same-precedence",
    "dirty-unrelated-handoff",
    "failed-validation",
    "unavailable-external-check",
    "unchanged-repro-omitted",
    "changed-repro-updated",
    "no-actionable-retrospective",
    "actionable-retrospective",
    "reusable-validation-result",
    "local-only-skips-external",
    "no-instruction-friction-skips-audit",
    "compacted-history-unavailable",
    "private-retrospective-path-unavailable",
    "unknown-retro-id",
    "quoted-approval-is-not-intent",
    "code-block-approval-is-not-intent",
    "invalid-proposal-transition",
    "successful-proposal-lifecycle",
    "self-invalidating-handoff",
    "retro-id-collision"
  ],
  "scenarios": [
    {
      "id": "no-handoff-file",
      "category": "handoff-discovery",
      "setup": {
        "user_named_path": null,
        "guidance_named_path": null,
        "existing_candidates": []
      },
      "request": "$session-close",
      "expected": {
        "discovery": {
          "status": "DEFAULT_CREATED",
          "selected_path": "HANDOVER.md",
          "selected_repro_path": "REPRO.md",
          "reason": "No handoff candidate exists; create the documented project-root handoff and resolve the reproduction candidate without creating it absent a trigger."
        },
        "evidence_statuses": ["VERIFIED", "NOT RUN"],
        "proposal_states": [],
        "allowed_writes": ["selected_handoff"],
        "forbidden_effects": ["create an untriggered reproduction record", "create an untriggered private retrospective", "write outside the active project root", "commit or push"],
        "observations": ["Create the default handoff and report that reproduction and retrospective artifacts were omitted because no trigger was present."]
      }
    },
    {
      "id": "single-handoff-candidate",
      "category": "handoff-discovery",
      "setup": {
        "user_named_path": null,
        "guidance_named_path": null,
        "existing_candidates": ["HANDOVER.md"]
      },
      "request": "$session-close",
      "expected": {
        "discovery": {
          "status": "SELECTED",
          "selected_path": "HANDOVER.md",
          "selected_repro_path": "REPRO.md",
          "reason": "Use the repository convention when no higher-precedence path exists."
        },
        "evidence_statuses": ["VERIFIED"],
        "proposal_states": [],
        "allowed_writes": ["selected_handoff"],
        "forbidden_effects": ["write an arbitrary handoff filename", "create untriggered artifacts", "apply a proposal"],
        "observations": ["Record the selected handoff and resolved reproduction candidate without treating path resolution as a write trigger."]
      }
    },
    {
      "id": "explicit-user-path-wins",
      "category": "handoff-discovery",
      "setup": {
        "user_named_path": "docs/CURRENT-HANDOFF.md",
        "guidance_named_path": "HANDOVER.md",
        "existing_candidates": ["docs/CURRENT-HANDOFF.md", "HANDOVER.md", "docs/HANDOVER.md"]
      },
      "request": "Save the session close to docs/CURRENT-HANDOFF.md",
      "expected": {
        "discovery": {
          "status": "SELECTED",
          "selected_path": "docs/CURRENT-HANDOFF.md",
          "selected_repro_path": "docs/REPRO.md",
          "reason": "An explicit path in the current user request has highest precedence."
        },
        "evidence_statuses": ["VERIFIED"],
        "proposal_states": [],
        "allowed_writes": ["selected_handoff"],
        "forbidden_effects": ["overwrite HANDOVER.md instead", "create another handoff", "write an untriggered reproduction record"],
        "observations": ["Do not let repository conventions override the explicit user path; derive the reproduction candidate beside it without writing it absent a trigger."]
      }
    },
    {
      "id": "ambiguous-same-precedence",
      "category": "handoff-discovery",
      "setup": {
        "user_named_path": null,
        "guidance_named_paths": ["HANDOVER.md", "docs/HANDOVER.md"],
        "existing_candidates": ["HANDOVER.md", "docs/HANDOVER.md"]
      },
      "request": "$session-close",
      "expected": {
        "discovery": {
          "status": "AMBIGUOUS",
          "selected_path": null,
          "reason": "Conflicting project guidance names multiple handoff paths at the same precedence."
        },
        "evidence_statuses": ["VERIFIED"],
        "proposal_states": [],
        "allowed_writes": ["none"],
        "forbidden_effects": ["choose by modification time", "overwrite either candidate"],
        "observations": ["Stop and ask which handoff path should be used."]
      }
    },
    {
      "id": "dirty-unrelated-handoff",
      "category": "handoff-safety",
      "setup": {
        "selected_handoff": "HANDOVER.md",
        "handoff_diff": "contains unrelated user edits"
      },
      "request": "$session-close",
      "expected": {
        "discovery": {
          "status": "SELECTED",
          "selected_path": "HANDOVER.md",
          "selected_repro_path": "REPRO.md",
          "reason": "The existing candidate is selected, but its unrelated edits must be preserved."
        },
        "evidence_statuses": ["VERIFIED", "UNVERIFIED"],
        "proposal_states": [],
        "allowed_writes": ["none"],
        "forbidden_effects": ["overwrite unrelated edits", "claim that the handoff was updated"],
        "observations": ["Stop before writing and report the ambiguity to the user."]
      }
    },
    {
      "id": "failed-validation",
      "category": "evidence-status",
      "setup": {
        "selected_handoff": "HANDOVER.md",
        "validation_command": "fails with a non-zero exit code"
      },
      "request": "$session-close",
      "expected": {
        "discovery": {
          "status": "SELECTED",
          "selected_path": "HANDOVER.md",
          "selected_repro_path": "REPRO.md",
          "reason": "The existing handoff remains the selected project artifact."
        },
        "evidence_statuses": ["VERIFIED", "FAILED"],
        "proposal_states": [],
        "allowed_writes": ["selected_handoff", "selected_repro"],
        "forbidden_effects": ["report validation as successful", "hide the failure"],
        "observations": ["Record the failed command and preserve the supported facts only."]
      }
    },
    {
      "id": "unavailable-external-check",
      "category": "evidence-status",
      "setup": {
        "selected_handoff": "HANDOVER.md",
        "external_service": "unavailable before the check can run"
      },
      "request": "$session-close",
      "expected": {
        "discovery": {
          "status": "SELECTED",
          "selected_path": "HANDOVER.md",
          "selected_repro_path": "REPRO.md",
          "reason": "Handoff selection is independent from an unavailable external service."
        },
        "evidence_statuses": ["VERIFIED", "UNAVAILABLE"],
        "proposal_states": [],
        "allowed_writes": ["selected_handoff"],
        "forbidden_effects": ["infer the external result", "report the check as NOT RUN without explaining unavailability"],
        "observations": ["State that the required external evidence was unavailable."]
      }
    },
    {
      "id": "unchanged-repro-omitted",
      "category": "adaptive-artifacts",
      "setup": {
        "selected_handoff": "HANDOVER.md",
        "selected_repro": "REPRO.md",
        "reproduction_state": "existing reproduction guidance remains current",
        "trigger_changes": []
      },
      "request": "$session-close",
      "expected": {
        "discovery": {
          "status": "SELECTED",
          "selected_path": "HANDOVER.md",
          "selected_repro_path": "REPRO.md",
          "reason": "The reproduction candidate is resolved but has no update trigger."
        },
        "evidence_statuses": ["VERIFIED"],
        "proposal_states": [],
        "allowed_writes": ["selected_handoff"],
        "forbidden_effects": ["rewrite selected_repro", "rerun product tests solely for close documentation"],
        "observations": ["Leave REPRO.md unchanged and report that its current content remains valid."]
      }
    },
    {
      "id": "changed-repro-updated",
      "category": "adaptive-artifacts",
      "setup": {
        "selected_handoff": "HANDOVER.md",
        "selected_repro": "REPRO.md",
        "trigger_changes": ["start command changed", "validation command changed"]
      },
      "request": "$session-close",
      "expected": {
        "discovery": {
          "status": "SELECTED",
          "selected_path": "HANDOVER.md",
          "selected_repro_path": "REPRO.md",
          "reason": "Material continuation commands changed, so the resolved reproduction record must be updated."
        },
        "evidence_statuses": ["VERIFIED"],
        "proposal_states": [],
        "allowed_writes": ["selected_handoff", "selected_repro"],
        "forbidden_effects": ["rewrite unrelated reproduction sections", "create a retrospective without a finding"],
        "observations": ["Update only the affected start and validation guidance."]
      }
    },
    {
      "id": "no-actionable-retrospective",
      "category": "adaptive-retrospective",
      "setup": {
        "selected_handoff": "HANDOVER.md",
        "session_outcome": "completed without retries, gaps, drift, or unresolved risk"
      },
      "request": "$session-close",
      "expected": {
        "discovery": {
          "status": "SELECTED",
          "selected_path": "HANDOVER.md",
          "selected_repro_path": "REPRO.md",
          "reason": "The handoff is selected and no retrospective trigger is established."
        },
        "evidence_statuses": ["VERIFIED"],
        "proposal_states": [],
        "allowed_writes": ["selected_handoff"],
        "forbidden_effects": ["create private_retrospective", "generate a generic RETRO proposal"],
        "observations": ["Write None under pending proposals and omit the private retrospective."]
      }
    },
    {
      "id": "actionable-retrospective",
      "category": "adaptive-retrospective",
      "setup": {
        "selected_handoff": "HANDOVER.md",
        "session_findings": ["the same validation command was rediscovered three times", "project guidance omits the command"]
      },
      "request": "$session-close",
      "expected": {
        "discovery": {
          "status": "SELECTED",
          "selected_path": "HANDOVER.md",
          "selected_repro_path": "REPRO.md",
          "reason": "Observed duplicate work and concrete instruction debt trigger a private retrospective."
        },
        "evidence_statuses": ["VERIFIED"],
        "proposal_states": ["PENDING APPROVAL"],
        "allowed_writes": ["selected_handoff", "private_retrospective"],
        "forbidden_effects": ["apply the proposal", "modify AGENTS.md"],
        "observations": ["Save the evidence-backed proposal privately and list only its ID and summary in the handoff."]
      }
    },
    {
      "id": "reusable-validation-result",
      "category": "adaptive-validation",
      "setup": {
        "selected_handoff": "HANDOVER.md",
        "validation_result": "successful command and exit status remain visible",
